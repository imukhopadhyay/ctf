# ─── CyberQuest CTF environment template ───
# Copy to .env and replace every secret. Never commit real values.
# Generate secrets with: openssl rand -hex 32

NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL (least-privilege application role recommended in production)
DATABASE_URL=postgresql://cyberquest:change-me@localhost:5432/cyberquest

# Redis (rate limits + leaderboard cache). Leave empty to use in-process fallback (single instance only).
REDIS_URL=redis://localhost:6379

# Secrets — each at least 32 characters
SESSION_SECRET=
FLAG_PEPPER=
INSTANCE_FLAG_SECRET=

SESSION_TTL_HOURS=168
REGISTRATION_ENABLED=true
# Set true only when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# Artifact storage (content-addressed, immutable)
STORAGE_DIR=./storage/artifacts
MAX_UPLOAD_MB=50

# Challenge runner (leave empty to disable execution-based challenges)
RUNNER_URL=
RUNNER_SHARED_SECRET=

# ─── Runner service only ───
RUNNER_PORT=4100
RUNNER_BACKEND=docker            # docker | disabled
RUNNER_PUBLIC_HOST=127.0.0.1     # host/IP participants use to reach instances
RUNNER_BIND_HOST=127.0.0.1       # interface published container ports bind to
RUNNER_ALLOWED_IMAGES=cyberquest/chal-
RUNNER_MAX_INSTANCES=50
RUNNER_DOCKER_RUNTIME=           # e.g. runsc (gVisor) for stronger isolation

# ─── Seed only (development data) ───
# Admin account created by the seed; password must be provided (no default).
SEED_ADMIN_EMAIL=admin@cyberquest.local
SEED_ADMIN_PASSWORD=
